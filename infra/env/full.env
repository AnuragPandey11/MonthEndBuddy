# Backend feature flags for the `full` stack (architecture §3): Redis cache and rate limits, Kafka events.
# No secrets here: this file is committed. Select it with MEB_STACK=full (see compose.yaml).
MEB_EVENTS_MODE=kafka
MEB_CACHE_ENABLED=true
MEB_RATELIMIT_MODE=redis
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Kafka gates readiness when events go through it; Redis never does (it fails open).
MEB_READINESS_INCLUDE=readinessState,db,kafka
