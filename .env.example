# Copy to .env and fill in local values. .env is git-ignored; never commit real secrets.
# Variable list: spec §15 and architecture §18.

SPRING_PROFILES_ACTIVE=local

# PostgreSQL
# The Compose database listens on host port 5433 (5432 is often taken by a local PostgreSQL).
DB_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/monthendbuddy
DB_USERNAME=monthendbuddy
# Local-only database password; it must match the backend's default when you run it outside Docker. Changing it
# after the first `docker compose up` needs `docker compose down -v` (it is fixed when the volume is created).
DB_PASSWORD=monthendbuddy

# Auth: REQUIRED, at least 32 random bytes. Generate one with: openssl rand -base64 48
# (The app refuses to start with this placeholder, because it is too short.)
JWT_SECRET=replace-me
# Used for Origin checks on /auth/refresh and /auth/logout
APP_BASE_URL=http://localhost:8080

# AI provider. Leave GROQ_API_KEY empty to run without the copilot (PROVIDER_UNAVAILABLE).
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Offline copilot: MEB_AGENT_PROVIDER=scripted with MEB_AGENT_SCRIPTED_DEMO=true answers every question with one
# real tool call and a fixed reply, without any AI provider.
MEB_AGENT_PROVIDER=groq
MEB_AGENT_SCRIPTED_DEMO=false

# Phase 5 infrastructure (only used with the `full` Compose profile)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Feature flags (normally set by infra/env/{core,full}.env)
MEB_EVENTS_MODE=in-process        # in-process | kafka
MEB_CACHE_ENABLED=false
MEB_RATELIMIT_MODE=in-memory      # in-memory | redis
